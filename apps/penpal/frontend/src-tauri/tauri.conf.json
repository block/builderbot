{
  "productName": "Penpal",
  "identifier": "com.penpal.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/Assets.car": "Assets.car",
      "../../.claude-plugin": ".claude-plugin",
      "../../plugin": "plugin"
    },
    "externalBin": [
      "binaries/penpal-server",
      "binaries/penpal-cli"
    ]
  }
}
