# Default recipe
default: dev

export PATH := env_var_or_default("CARGO_HOME", env_var("HOME") + "/.cargo") + "/bin:" + env_var("PATH")

# Ensure required tools are installed
ensure-deps:
    #!/usr/bin/env bash
    if ! command -v go &> /dev/null; then
        echo "Installing Go..."
        brew install go
    fi
    if ! command -v cargo &> /dev/null; then
        echo "Installing Rust..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    fi
    if ! command -v claude &> /dev/null; then
        echo "Installing Claude Code..."
        brew install claude-code
    fi
    if ! command -v node &> /dev/null; then
        echo "Installing Node.js..."
        brew install node
    fi
    if ! command -v pnpm &> /dev/null; then
        echo "Installing pnpm..."
        brew install pnpm
    fi

# Build production desktop app
build: ensure-deps build-go
    cd frontend && pnpm install && VITE_BASE=/ VITE_API_URL=http://localhost:8080 pnpm run build && pnpm run tauri:build

# Development mode: full desktop app with Vite HMR
dev: ensure-deps build-go
    cd frontend && VITE_BASE=/ PENPAL_PORT=8082 pnpm run tauri:dev

# Build Go binaries (server sidecar + CLI) for desktop app
build-go: ensure-deps
    ./scripts/build-go.sh

# Install Penpal: build dev-branded desktop app and copy to /Applications
install: ensure-deps build-go
    #!/usr/bin/env bash
    set -euo pipefail

    # Build with "Penpal Dev" product name so devs can distinguish from Homebrew installs
    cd frontend && pnpm install && VITE_BASE=/ VITE_API_URL=http://localhost:8080 pnpm run build \
        && npx tauri build --config '{"productName":"Penpal Dev"}'

    cd ..

    # Quit running Penpal if present
    if pgrep -x Penpal >/dev/null 2>&1; then
        echo "Quitting Penpal..."
        osascript -e 'quit app "Penpal"' 2>/dev/null || true
        sleep 1
        pkill -x Penpal 2>/dev/null || true
    fi

    # The dev build bundles as "Penpal Dev.app"
    APP_SRC="frontend/src-tauri/target/release/bundle/macos/Penpal Dev.app"
    if [ -d "$APP_SRC" ]; then
        echo "Installing Penpal.app to /Applications..."
        rm -rf /Applications/Penpal.app
        cp -R "$APP_SRC" /Applications/Penpal.app
        echo "Penpal.app installed (dev build)."
    else
        echo "Warning: $APP_SRC not found, skipping app install."
    fi

    # Launch the app — CLI + plugin are installed via in-app menu
    open /Applications/Penpal.app

# Package .app into a distributable zip
package: build
    ./scripts/package.sh

# Uninstall Penpal
uninstall:
    #!/usr/bin/env bash
    rm -rf /Applications/Penpal.app 2>/dev/null || true
    echo "Penpal.app removed from /Applications."
    rm -f "$(brew --prefix 2>/dev/null)/bin/penpal" 2>/dev/null || rm -f /usr/local/bin/penpal 2>/dev/null || true
    claude plugin uninstall penpal 2>/dev/null || true
    claude plugin marketplace remove penpal 2>/dev/null || true
    echo "Penpal uninstalled."

# ============================================================================
# Code Quality
# ============================================================================

# Auto-format all code
fmt: ensure-deps
    gofmt -w .

# Verify formatting without modifying files (used by CI/hooks)
fmt-check: ensure-deps
    #!/usr/bin/env bash
    set -euo pipefail
    test -z "$(gofmt -l .)" || { gofmt -l . ; echo "Go files need formatting"; exit 1; }

# Lint Rust code with clippy
lint: ensure-deps
    #!/usr/bin/env bash
    set -euo pipefail
    cd frontend/src-tauri
    # Create stub sidecar so Tauri build script passes the resource-path check
    target_triple=$(rustc -vV | sed -n 's|host: ||p')
    mkdir -p binaries
    touch "binaries/penpal-server-${target_triple}"
    touch "binaries/penpal-cli-${target_triple}"
    cargo clippy -- -D warnings

# Type-check frontend (TypeScript)
typecheck: ensure-deps
    cd frontend && pnpm run typecheck

# Run all tests
test: ensure-deps
    go test ./... && cd frontend && pnpm run test:run

# Verify everything without modifying files — for CI
ci: ensure-deps fmt-check lint typecheck test

# ============================================================================
# Release
# ============================================================================

# Generate changelog entry for a release version
changelog version:
    #!/usr/bin/env bash
    set -euo pipefail

    LAST_TAG=$(git describe --tags --match "penpal-*" --abbrev=0 2>/dev/null || echo "")
    if [ -n "$LAST_TAG" ]; then
        COMMITS=$(git log --oneline "$LAST_TAG"..HEAD -- .)
    else
        COMMITS=$(git log --oneline -- .)
    fi

    if [ -z "$COMMITS" ]; then
        echo "No commits found since last release."
        exit 1
    fi

    echo "$COMMITS" | claude -p --dangerously-skip-permissions \
        "These are commits since the last release. Prepend a new changelog section to CHANGELOG.md using v{{version}} as the heading. Group changes by theme and write human-readable descriptions, not raw commit messages. Match the existing style."

    penpal open CHANGELOG.md
    read -p "Press enter when done editing changelog..."

# Bump version, generate changelog, and open a release PR
prepare version:
    #!/usr/bin/env bash
    set -euo pipefail

    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [ "$current_branch" != "main" ]; then
        echo "Error: prepare must be run from the main branch (currently on '$current_branch')" >&2
        exit 1
    fi

    branch="release/penpal-v{{version}}"

    # Create release branch from main
    git checkout -b "$branch"

    # Update version in Cargo.toml (source of truth)
    sed -i '' 's/^version = ".*"/version = "{{version}}"/' frontend/src-tauri/Cargo.toml
    # Update version in package.json
    cd frontend && npm version "{{version}}" --no-git-tag-version && cd ..

    # Generate and review changelog
    just changelog {{version}}

    # Commit and push the release branch
    git add frontend/src-tauri/Cargo.toml frontend/package.json CHANGELOG.md
    git commit -m "release: penpal v{{version}}"
    git push origin "$branch"

    # Open a PR
    gh pr create \
        --draft \
        --title "release: penpal v{{version}}" \
        --body "Release penpal v{{version}}. Merge this PR, then run \`just release <merge-sha>\` to tag and publish." \
        --base main

    echo ""
    echo "Release PR created. Once merged, run 'just release <merge-sha>' to tag and publish."

# Tag a commit and push to trigger the release build
release sha:
    #!/usr/bin/env bash
    set -euo pipefail

    version=$(grep '^version' frontend/src-tauri/Cargo.toml | head -1 | sed 's/version = "//;s/"//')
    tag="penpal-${version}"

    if git ls-remote --tags origin "refs/tags/${tag}" | grep -q .; then
        echo "Error: tag '${tag}' already exists on the remote." >&2
        exit 1
    fi

    git tag "$tag" "{{sha}}"
    git push origin "$tag"
    echo "Pushed tag ${tag} — CI will build and publish the release."

# ============================================================================
# Other
# ============================================================================

# Run Playwright e2e tests
test-e2e: ensure-deps
    cd e2e && pnpm exec playwright test

# Clean build artifacts
clean:
    rm -f penpal
    rm -rf dist
    rm -rf frontend/dist
    rm -rf frontend/src-tauri/target
    rm -rf frontend/src-tauri/binaries
