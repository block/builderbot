# Staged - AI-Powered Development Workspace
# Run `just dev` to start development.

# ============================================================================
# Setup
# ============================================================================

# First-time setup: install all dependencies
install:
    pnpm install
    cd src-tauri && cargo fetch

# ============================================================================
# Development
# ============================================================================

# Build the stagedctl CLI and stage it where `bundle.externalBin` expects it
# (src-tauri/binaries/stagedctl-<triple>). Required before ANY cargo build of
# the app crate — tauri-build fails when the sidecar file is missing — so
# dev/lint/test depend on this, and the tauri before-dev/before-build hooks
# run the same script.
stage-sidecar:
    bash scripts/prepare-stagedctl-sidecar.sh

# Run the app in development mode (optionally point to another repo)
dev repo="": stage-sidecar
    #!/usr/bin/env bash
    set -euo pipefail

    # Install JS deps if they are missing or older than the workspace lockfile.
    # The lockfile lives at the repo root, and pnpm rewrites the root
    # node_modules/.modules.yaml on every install, so that file is the install's
    # timestamp. node_modules' own mtime is not: it only moves when a top-level
    # entry is added or removed, so a rebase that bumps versions in place leaves
    # it untouched and the stale packages go unnoticed.
    if [[ ! -d node_modules || ../../pnpm-lock.yaml -nt ../../node_modules/.modules.yaml ]]; then
        pnpm install
    fi

    # Dev instances share the managed ACP bridges and Node runtime in
    # ~/.staged/packages with every other Staged instance. Export
    # STAGED_ACP_TOOLS_DIR manually to point sessions at a local bridge
    # checkout instead (it disables the managed installs).

    # Derive a stable port from the working directory so the same worktree
    # always gets the same port. This avoids changing TAURI_CONFIG between
    # runs, which would invalidate Cargo's build cache and trigger a full
    # Rust rebuild every time.
    VITE_PORT=$(python3 -c "import hashlib,os; h=int(hashlib.sha256(os.getcwd().encode()).hexdigest(),16); print(10000 + h % 55000)")
    export VITE_PORT
    TAURI_CONFIG="{\"build\":{\"devUrl\":\"http://localhost:${VITE_PORT}\",\"beforeDevCommand\":\"exec ./node_modules/.bin/vite --port ${VITE_PORT} --strictPort\"}}"

    # In worktrees, generate a labeled icon so you can tell instances apart
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        GIT_DIR=$(git rev-parse --git-dir)
        if [[ "$GIT_DIR" == *".git/worktrees/"* ]]; then
            BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
            WORKTREE_LABEL="${BRANCH_NAME##*/}"

            ICON_DIR="$(pwd)/src-tauri/target/dev-icons"
            mkdir -p "$ICON_DIR"
            DEV_ICON="$ICON_DIR/icon.icns"

            if swift ../../scripts/generate-dev-icon.swift src-tauri/icons/icon.icns "$DEV_ICON" "$WORKTREE_LABEL"; then
                echo "🌳 Worktree: ${WORKTREE_LABEL}"
                export VITE_DEV_BRANCH="$WORKTREE_LABEL"
                TAURI_CONFIG="{\"build\":{\"devUrl\":\"http://localhost:${VITE_PORT}\",\"beforeDevCommand\":\"exec ./node_modules/.bin/vite --port ${VITE_PORT} --strictPort\"},\"bundle\":{\"icon\":[\"$DEV_ICON\"]}}"
            fi
        fi
    fi

    echo "Starting on port ${VITE_PORT}"
    {{ if repo != "" { "export STAGED_REPO=" + repo } else { "" } }}
    pnpm exec tauri dev --config "$TAURI_CONFIG"

# Run with the HTTPS web server enabled for phone/browser access.
# Requires PEM cert/key files and a hostname covered by the certificate.
# The server is unauthenticated and binds 0.0.0.0:5175: anyone who can reach
# the port can run repo actions. Only use it on a network you trust.
dev-web repo="":
    #!/usr/bin/env bash
    set -euo pipefail

    [[ -d node_modules ]] || pnpm install

    if [[ -z "${STAGED_WEB_CERT_PATH:-}" || -z "${STAGED_WEB_KEY_PATH:-}" || -z "${STAGED_WEB_HOST:-}" ]]; then
        printf '%s\n' \
            'Error: `just dev-web` serves browser access over HTTPS.' \
            'Provide PEM certificate/key files and a hostname covered by the certificate:' \
            '' \
            '  STAGED_WEB_CERT_PATH=/path/to/cert.pem \' \
            '  STAGED_WEB_KEY_PATH=/path/to/key.pem \' \
            '  STAGED_WEB_HOST=hostname.example.com \' \
            '  just dev-web' >&2
        exit 1
    fi

    VITE_PORT=$(python3 -c "import hashlib,os; h=int(hashlib.sha256(os.getcwd().encode()).hexdigest(),16); print(10000 + h % 55000)")
    export VITE_PORT
    export STAGED_WEB_SERVER=1
    TAURI_CONFIG="{\"build\":{\"devUrl\":\"https://${STAGED_WEB_HOST}:${VITE_PORT}\",\"beforeDevCommand\":\"exec ./node_modules/.bin/vite --port ${VITE_PORT} --strictPort --host 0.0.0.0\"}}"

    echo "Starting on https://${STAGED_WEB_HOST}:${VITE_PORT} (HTTPS web server on :5175)"
    {{ if repo != "" { "export STAGED_REPO=" + repo } else { "" } }}
    pnpm exec tauri dev --config "$TAURI_CONFIG"

# Build and run the release app with the HTTPS web server. Requires PEM cert/key files.
# Same warning as `dev-web`: unauthenticated on 0.0.0.0:5175, anyone who can
# reach the port can run repo actions.
run-web:
    #!/usr/bin/env bash
    set -euo pipefail

    # Unlike `dev-web` there is no Vite/HMR: the desktop window and the phone
    # get the same built bundle, so this is the path that exercises the service
    # worker and the production frontend. One Staged process at a time — a
    # `just dev`/`dev-web` instance elsewhere shares ~/.staged and the port.

    [[ -d node_modules ]] || pnpm install

    if [[ -z "${STAGED_WEB_CERT_PATH:-}" || -z "${STAGED_WEB_KEY_PATH:-}" ]]; then
        printf '%s\n' \
            'Error: `just run-web` serves browser access over HTTPS.' \
            'Provide PEM certificate/key files covering the hostname you browse to:' \
            '' \
            '  STAGED_WEB_CERT_PATH=/path/to/cert.pem \' \
            '  STAGED_WEB_KEY_PATH=/path/to/key.pem \' \
            '  just run-web' >&2
        exit 1
    fi

    # `tauri build` runs `pnpm run build` first, so dist/ is always regenerated
    # here. The window's assets are compiled into the binary while the server
    # reads dist/ from disk — rebuilding both together keeps them in sync.
    # `--bundles app` skips the DMG that `just build` would also produce.
    pnpm exec tauri build --bundles app

    # Cargo resolves a relative CARGO_TARGET_DIR against its own cwd (src-tauri)
    TARGET_DIR="$(pwd)/src-tauri/target"
    if [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
        case "$CARGO_TARGET_DIR" in
            /*) TARGET_DIR="$CARGO_TARGET_DIR" ;;
            *) TARGET_DIR="$(pwd)/src-tauri/$CARGO_TARGET_DIR" ;;
        esac
    fi

    APP_BIN="$TARGET_DIR/release/bundle/macos/Staged.app/Contents/MacOS/Staged"
    if [[ ! -x "$APP_BIN" ]]; then
        echo "Error: no app bundle at $APP_BIN" >&2
        exit 1
    fi

    export STAGED_WEB_SERVER=1

    # A bundled release binary cannot find dist/ relative to itself, so point
    # the server at it directly rather than relying on the launch cwd.
    export STAGED_WEB_DIST="$(pwd)/dist"

    "$APP_BIN" &
    APP_PID=$!
    trap 'kill "$APP_PID" 2>/dev/null || true' EXIT

    # Release builds install no logger, so web server failures (bad cert path,
    # :5175 already bound by another Staged instance) are completely silent.
    # Probe the server rather than trusting that the app launched.
    STATUS=000
    for _ in $(seq 1 30); do
        kill -0 "$APP_PID" 2>/dev/null || break
        STATUS=$(curl -sk --max-time 2 -o /dev/null -w '%{http_code}' https://localhost:5175/sw.js) || true
        [[ "$STATUS" == "000" ]] || break
        sleep 1
    done

    case "$STATUS" in
        2*|3*)
            echo "Web server ready on https://${STAGED_WEB_HOST:-$(hostname)}:5175"
            ;;
        404)
            echo "Web server is up but is serving 404s — check STAGED_WEB_DIST=$STAGED_WEB_DIST holds the built bundle." >&2
            ;;
        *)
            printf '%s\n' \
                'Web server never came up on :5175. Release builds log nothing, so check:' \
                '  - STAGED_WEB_CERT_PATH / STAGED_WEB_KEY_PATH point at readable PEM files' \
                '  - no other Staged instance already holds the port' >&2
            ;;
    esac

    wait "$APP_PID" || true

# Build the app for production
build:
    pnpm run tauri:build

# Generate the release-only Tauri config with updater settings
release-config:
    pnpm run tauri:release:config

# Build a signed/notarized release bundle once release config exists
release-build target="aarch64-apple-darwin" *args:
    pnpm exec tauri build --target {{target}} --config src-tauri/tauri.release.conf.json {{args}}

# Create a release branch, bump staged versions, and open a release PR
prepare version:
    #!/usr/bin/env bash
    set -euo pipefail

    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [ "$current_branch" != "main" ]; then
        echo "Error: prepare must be run from the main branch (currently on '$current_branch')" >&2
        exit 1
    fi

    if [ -n "$(git status --short)" ]; then
        echo "Error: working tree must be clean before preparing a release." >&2
        exit 1
    fi

    branch="release/staged-v{{version}}"

    git pull --ff-only origin main
    git switch -c "$branch"

    node scripts/bump-version.mjs "{{version}}"
    cd src-tauri && cargo generate-lockfile && cd ..

    git add package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock
    git commit -m "release: staged v{{version}}"
    git push --set-upstream origin "$branch"

    gh pr create \
        --title "release: staged v{{version}}" \
        --body "Release staged v{{version}}. Merge this PR, then run \`just release {{version}}\` from \`apps/staged\` on \`main\` to tag and publish." \
        --base main \
        --head "$branch"

    echo ""
    echo "Release PR created. Once merged, run 'just release {{version}}' from apps/staged on main."

# Tag and push the merged release commit to trigger the release workflow
release version:
    #!/usr/bin/env bash
    set -euo pipefail

    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [ "$current_branch" != "main" ]; then
        echo "Error: release must be run from the main branch (currently on '$current_branch')" >&2
        exit 1
    fi

    git pull --ff-only origin main

    expected_msg="release: staged v{{version}}"
    release_sha=$(git log --format="%H %s" main | grep -F "$expected_msg" | head -1 | cut -d' ' -f1 || true)
    if [ -z "$release_sha" ]; then
        echo "Error: could not find commit '$expected_msg' on main." >&2
        echo "Make sure the release PR has been merged and you've pulled latest main." >&2
        exit 1
    fi

    git tag "staged/v{{version}}" "$release_sha"
    git push origin "staged/v{{version}}"

    echo "Pushed tag staged/v{{version}} — CI will build and publish the release."

# Fetch official Node.js release checksums and update node-runtime.lock.json (e.g. `just bump-node-runtime v24.21.0`)
bump-node-runtime *ARGS:
    node scripts/update-node-runtime-lock.mjs {{ ARGS }}

# ============================================================================
# Code Quality
# ============================================================================

# Auto-format all code
fmt:
    cd src-tauri && cargo fmt
    pnpm exec prettier --write "src/**/*.{ts,svelte,css,html}"

# Verify formatting without modifying files
fmt-check: fmt-check-rust fmt-check-frontend

# Verify Rust formatting
fmt-check-rust:
    cd src-tauri && cargo fmt --check

# Verify frontend formatting
fmt-check-frontend:
    pnpm exec prettier --check "src/**/*.{ts,svelte,css,html}"

# Lint Rust code with clippy
lint: stage-sidecar
    cd src-tauri && cargo clippy --workspace -- -D warnings

# Run Rust unit tests
test: stage-sidecar
    cd src-tauri && cargo test --workspace --lib --bins --tests

# Run frontend unit tests
test-frontend:
    pnpm test

# Type-check frontend (Svelte + TypeScript)
typecheck:
    pnpm run check

# Format, then verify everything passes — run before pushing
check-all: fmt lint typecheck test test-frontend

# ============================================================================
# CI
# ============================================================================
# Each Staged CI job (.github/workflows/staged-ci.yml) runs one ci-* group,
# and `ci` runs all of them, so CI and local runs cover the same checks.

# Frontend checks: prettier, svelte-check + tsc, vitest (CI "Frontend" job)
ci-frontend: fmt-check-frontend typecheck test-frontend

# Rust lint: cargo fmt + clippy (CI "Rust lint" job)
ci-rust-lint: fmt-check-rust lint

# Rust tests (CI "Rust test" job)
ci-rust-test: test

# Verify everything without modifying files, one check at a time
ci: ci-frontend ci-rust-lint ci-rust-test

# Pre-push hook: `ci` with frontend and Rust run concurrently; skips Rust when no Rust-affecting file changed
ci-local:
    #!/usr/bin/env bash
    set -euo pipefail

    # Keep in sync with the `rust` paths filter in .github/workflows/staged-ci.yml.
    rust_paths='^(apps/staged/src-tauri/|apps/staged/src/lib/shared/prompts/|apps/staged/node-runtime\.lock\.json$|apps/staged/justfile$|crates/|Cargo\.[^/]*$|rust-toolchain\.toml$|bin/|\.github/workflows/staged-ci\.yml$)'

    # Skip Rust when this branch, as its PR shows it, changes none of those
    # paths. The script explains a skip, and skips nothing without a merge-base.
    run_rust=true
    if "{{ justfile_directory() }}/../../scripts/unchanged" "Rust checks" "$rust_paths"; then
        run_rust=false
    fi

    # Prefix each group's output so the concurrent logs stay readable.
    run_group() {
        local label=$1
        shift
        "{{ just_executable() }}" -f "{{ justfile() }}" "$@" 2>&1 \
            | awk -v prefix="[$label] " '{ print prefix $0; fflush() }'
    }

    # Job control gives each group its own process group, so an interrupt can
    # stop the whole tree. (Without it, background jobs ignore SIGINT.)
    set -m
    pids=()
    labels=()
    run_group frontend ci-frontend < /dev/null &
    pids+=("$!")
    labels+=(frontend)
    if [[ $run_rust == true ]]; then
        # Lint, then test: clippy and the test build share cargo's build
        # directory lock, so running them concurrently gains nothing.
        run_group rust ci-rust-lint ci-rust-test < /dev/null &
        pids+=("$!")
        labels+=(rust)
    fi
    stop_groups() {
        for pid in "${pids[@]}"; do
            kill -TERM -- "-$pid" 2> /dev/null || true
        done
        exit 130
    }
    trap stop_groups INT TERM

    failed=()
    for i in "${!pids[@]}"; do
        wait "${pids[$i]}" || failed+=("${labels[$i]}")
    done
    if (( ${#failed[@]} )); then
        echo "ci-local: failed: ${failed[*]}" >&2
        exit 1
    fi
    echo "ci-local: passed: ${labels[*]}"

# ============================================================================
# Maintenance
# ============================================================================

# Delete all build artifacts and dependencies
clean:
    rm -rf dist node_modules
    rm -rf src-tauri/target
